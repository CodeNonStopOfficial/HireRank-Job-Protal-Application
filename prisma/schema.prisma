generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  COMPANY
  JOB_SEEKER
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  role          UserRole  @default(JOB_SEEKER)

  userType UserType?

  onboadingCompleted Boolean @default(false)

  company   Company?
  jobSeeker JobSeeker?

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  userSubscriptions UserSubscription[]
  payments          Payment[]
  jobBookmarks      JobBookmark[]
  interview         Interview[]

  @@index([role])
}

enum UserType {
  COMPANY
  JOB_SEEKER
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Company {
  id           String  @id @default(uuid())
  name         String
  location     String
  about        String
  logo         String
  website      String
  xAccount     String?
  linkedin     String?
  employes     String?
  organization String?

  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  jobs      Job[]
}

model JobSeeker {
  id         String   @id @default(uuid())
  name       String
  about      String   @db.Text()
  resume     String
  headline   String?
  phone      String?
  location   String?
  linkeding  String?
  githubUrl  String?
  xAccount   String?
  website    String?
  skills     String[] @default([])
  experience Int?
  education  String?

  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ApplicationStatus {
  APPLIED
  REVIEWING
  SHORTLISTED
  INTERVIEW
  HIRED
  REJECTED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  TEMPORARY
  FREELANCE
}

enum WorkplaceType {
  ONSITE
  REMOTE
  HYBRID
}

enum ExperienceLevel {
  ENTRY_LEVEL
  JUNIOR
  MID_LEVEL
  SENIOR
  LEAD
  EXECUTIVE
}

enum JobStatus {
  PENDING
  APPROVED
  REJECTED
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

model Job {
  id              String          @id @default(cuid())
  title           String
  department      String?
  location        String
  benefits        String[]
  workplaceType   WorkplaceType   @default(ONSITE)
  employmentType  EmploymentType  @default(FULL_TIME)
  experienceLevel ExperienceLevel @default(ENTRY_LEVEL)
  salaryMin       Int
  salaryMax       Int
  salaryCurrency  String?         @default("INR") @db.VarChar(3)
  salaryPeriod    String?

  openings     Int      @default(0)
  description  String?  @db.Text
  requirements String?  @db.Text
  skills       String[] @default([])

  status JobStatus @default(DRAFT)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  publishedAt  DateTime?
  jobBookmarks JobBookmark[]
  isBookmarked Boolean?      @default(false)

  @@index([companyId])
  @@index([status, createdAt])
  @@index([location])
  @@index([employmentType, workplaceType])
}

// subscription plain

enum PlanInterval {
  MONTHLY
  QUARTERLY
  YEARLY
  LIFETIME
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  AUTHENTICATION_FAILED
  HALTED
  CANCELLED
  EXPIRED
  COMPLETED
}

enum PaymentStatus {
  CREATED
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentType {
  ONE_TIME
  RECURRING
}

enum WebhookStatus {
  RECEIVED
  PROCESSED
  FAILED
}

model SubscriptionPlan {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?

  // Store all monetary amounts in the smallest currency unit.
  // For INR, 49900 means ₹499.00.
  price         Int
  currency      String       @default("INR")
  interval      PlanInterval @default(MONTHLY)
  intervalCount Int          @default(1)

  // Job portal features and limits.
  jobLimit        Int     @default(5)
  featuredJobs    Int     @default(0)
  resumeAccess    Boolean @default(false)
  companyBranding Boolean @default(false)
  prioritySupport Boolean @default(false)

  // Optional Razorpay plan ID for recurring billing.
  razorpayPlanId String? @unique

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions UserSubscription[]

  @@index([isActive])
}

model UserSubscription {
  id String @id @default(cuid())

  // Employer/customer who purchased the plan.
  userId String
  planId String

  // Snapshot the purchased price so later plan price changes
  // do not change the historical subscription amount.
  amount   Int
  currency String @default("INR")

  status      SubscriptionStatus @default(PENDING)
  paymentType PaymentType        @default(ONE_TIME)

  // Razorpay identifiers.
  razorpaySubscriptionId String? @unique
  razorpayCustomerId     String?

  // Track subscription validity.
  startsAt      DateTime?
  endsAt        DateTime?
  nextBillingAt DateTime?
  cancelledAt   DateTime?

  // Track job usage for the current subscription period.
  jobsPosted Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  plan     SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  payments Payment[]

  @@index([userId, status])
  @@index([planId])
  @@index([endsAt])
}

model Payment {
  id String @id @default(cuid())

  userId         String
  subscriptionId String?

  amount   Int
  currency String        @default("INR")
  status   PaymentStatus @default(CREATED)

  // Razorpay order and payment identifiers.
  razorpayOrderId   String? @unique
  razorpayPaymentId String? @unique

  // Refund details.
  refundAmount     Int     @default(0)
  razorpayRefundId String?

  // Store gateway error details when available.
  errorCode        String?
  errorDescription String?

  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user         User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  subscription UserSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([subscriptionId])
  @@index([createdAt])
}

model RazorpayWebhookEvent {
  id String @id @default(cuid())

  // The Razorpay event identifier, when provided.
  razorpayEventId String?       @unique
  eventType       String
  status          WebhookStatus @default(RECEIVED)

  // Store the verified event payload for processing/auditing.
  payload Json

  processedAt  DateTime?
  errorMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventType, status])
  @@index([createdAt])
}

// bookmark job 

model JobBookmark {
  id        String   @id @default(cuid())
  userId    String
  jobId     String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([userId])
}

enum InterviewStatus {
  SCHEDULED
  LIVE
  COMPLETED
  CANCELLED
}

model Interview {
  id String @id @default(cuid())

  recruiterId   String
  candidateId   String
  applicationId String

  zoomSessionName String @unique

  scheduledAt DateTime
  duration    Int      @default(30)

  status InterviewStatus @default(SCHEDULED)

  startedAt DateTime?
  endedAt   DateTime?

  feedback String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String?

  @@index([recruiterId])
  @@index([candidateId])
  @@index([applicationId])
}
